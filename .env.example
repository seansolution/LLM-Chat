# ═══════════════════════════════════════════════════════════
# Multi-Model Chat — Environment Variables
# Copy to .env and fill in the API keys you have.
# Models without a key will not be available in the UI.
# ═══════════════════════════════════════════════════════════

# ─── Local (LM Studio) ─────────────────────────────────────
# No env var needed — LiteLLM config points to host.docker.internal:1234
# Start LM Studio, load any model, enable server on port 1234.

# ─── LiteLLM Gateway ───────────────────────────────────────
LITELLM_MASTER_KEY=sk-litellm-master

# ─── OpenAI ────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Enables: GPT-4o, GPT-4o mini, GPT-4.1, GPT-4.1 mini, o3, o4-mini
OPENAI_API_KEY=

# ─── Anthropic (Claude) ────────────────────────────────────
# Get from: https://console.anthropic.com/
# Enables: Claude Opus 4, Sonnet 4, 3.7 Sonnet, Haiku 3.5
ANTHROPIC_API_KEY=

# ─── Google (Gemini) ───────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
# Enables: Gemini 2.5 Flash, 2.5 Pro, 2.0 Flash
GOOGLE_API_KEY=

# ─── xAI (Grok) ────────────────────────────────────────────
# Get from: https://console.x.ai/
# Enables: Grok 3, Grok 3 mini, Grok 2
XAI_API_KEY=

# ─── Deepseek ──────────────────────────────────────────────
# Get from: https://platform.deepseek.com/
# Enables: Deepseek V3, Deepseek R1
DEEPSEEK_API_KEY=

# ─── Perplexity ────────────────────────────────────────────
# Get from: https://www.perplexity.ai/settings/api
# Enables: Perplexity Sonar, Sonar Pro (includes web search)
PERPLEXITY_API_KEY=

# ─── Groq (Meta Llama inference) ───────────────────────────
# Get from: https://console.groq.com/
# Enables: Llama 4 Scout, Llama 4 Maverick, Llama 3.3 70B
GROQ_API_KEY=

# ─── ThaiLLM (OpenAI-compatible) ───────────────────────────
# Get API key from: http://thaillm.or.th/
# Enables:
# - openthaigpt-thaillm-8b-instruct-v7.2
# - pathumma-thaillm-qwen3-8b-think-3.0.0
# - typhoon-s-thaillm-8b-instruct
# - thalle-0.2-thaillm-8b-fa
THAILLM_URL=http://thaillm.or.th/api/v1
THAILLM_API_KEY=
THAILLM_CONSUMER_ID=

# ─── Authentik ─────────────────────────────────────────────
AUTHENTIK_SECRET_KEY=change-me-in-production-32chars!!
AUTHENTIK_CLIENT_ID=rag-backend
AUTHENTIK_CLIENT_SECRET=

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-32chars!!

# ─── Langfuse ──────────────────────────────────────────────
LANGFUSE_NEXTAUTH_SECRET=change-me-in-production
LANGFUSE_SALT=change-me-in-production
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Grafana ───────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ─── Next.js ───────────────────────────────────────────────
BACKEND_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001

# ─── Retrieval / Knowledge Base (Phase 6) ─────────────────
# Set RETRIEVAL_BACKEND=rag to enable vector search in knowledge mode.
# 'none' (default) — skip retrieval entirely
# 'rag'            — pgvector similarity search
RETRIEVAL_BACKEND=none

# Embedding model served by LiteLLM (or any OpenAI-compatible endpoint)
EMBEDDING_URL=http://litellm:4000
EMBEDDING_API_KEY=sk-litellm-master
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval tuning
CHUNK_SIZE=400
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.30
